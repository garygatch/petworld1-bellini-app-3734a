    {
      "body": "const query = String($ctrl.searchQuery || '').trim().toLocaleLowerCase();\nconst category = $ctrl.category;\nconst direction = $ctrl.sortOrder === 'desc' ? -1 : 1;\n// Filtering creates a new array; never sort shared service data.\n$ctrl.filteredPets = $ctrl.searchIndex.filter(entry => (!query || entry.text.includes(query)) && (category === '*' || 'category:' + entry.pet.category === category)).map(entry => entry.pet).sort((a, b) => direction * (a.name.localeCompare(b.name, undefined, { sensitivity: 'base' }) || String(a.id).localeCompare(String(b.id))));\n$ctrl.currentPage = 1;\n$ctrl.slicePage();",
      "description": "Computes search/category filtering and deterministic name sorting outside the digest view path. Resets pagination on every filter or accepted load.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "applyFilters",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
