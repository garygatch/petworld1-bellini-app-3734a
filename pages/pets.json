    {
      "body": "$ctrl.totalPages = Math.max(1, Math.ceil($ctrl.filteredPets.length / $ctrl.pageSize));\n$ctrl.currentPage = Math.max(1, Math.min($ctrl.totalPages, Math.floor(Number($ctrl.currentPage) || 1)));\nconst offset = ($ctrl.currentPage - 1) * $ctrl.pageSize;\n$ctrl.visiblePets = $ctrl.filteredPets.slice(offset, offset + $ctrl.pageSize);\n$ctrl.rangeStart = $ctrl.filteredPets.length ? offset + 1 : 0;\n$ctrl.rangeEnd = Math.min(offset + $ctrl.pageSize, $ctrl.filteredPets.length);",
      "description": "Clamps the current page and slices a maximum of 12 entries. Called after recomputation and after the explicit Pagination handler assigns its callback value.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "slicePage",
      "parameters": [],
