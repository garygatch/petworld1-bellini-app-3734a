      },
      "type": "method",
      "watch": []
    },
    {
      "body": "$ctrl.searchQuery = '';\n$ctrl.category = '*';\n$ctrl.sortOrder = 'asc';\n$ctrl.currentPage = 1;\nif ($ctrl.status !== 'available') {\n  $ctrl.status = 'available';\n  return $ctrl.syncStatus();\n}\n$ctrl.applyFilters();",
      "description": "Clears search/category/sort, restores available status, resets page, and reloads only if status changes. Safe while a prior status request is pending.",
      "invokeOnLoad": false,
