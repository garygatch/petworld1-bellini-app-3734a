    {
      "body": "$ctrl.status = value;\nreturn $ctrl.syncStatus();",
      "description": "Verified Dropdown onValueChange(value, event) adapter. Explicitly assigns the two-way status before syncStatus so recomputation does not depend on binding propagation timing. The requestedStatus guard deduplicates callback/watch/init loads.",
      "invokeOnLoad": false,
