      "watch": []
    },
    {
      "body": "$ctrl.currentPage = currentPage;\n$ctrl.slicePage();",
      "description": "Verified Pagination onPageChange(currentPage) adapter for all page changes, including first/last. Pagination updates its two-way model before notifying; explicitly assigning the callback value also makes the slice independent of parent-binding propagation timing. No network work.",
      "invokeOnLoad": false,
