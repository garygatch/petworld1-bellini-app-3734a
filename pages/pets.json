      "watch": []
    },
    {
      "body": "$ctrl.applyFilters();",
      "description": "Debounced search callback reads the latest model, including resets, rather than a potentially old callback argument.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "searchChanged",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "const status = $ctrl.status;\nconst token = ++$ctrl.requestToken;\n$ctrl.requestedStatus = status;\n$ctrl.isLoading = true;\n$ctrl.loadError = null;\n$ctrl.updatedAt = null;\n$ctrl.allPets = [];\n$ctrl.searchIndex = [];\n$ctrl.filteredPets = [];\n$ctrl.categoryOptions = [{ label: 'All categories', value: '*' }];\n$ctrl.currentPage = 1;\n$ctrl.slicePage();\n// $q handles synchronous service failures as well as rejected service promises.\nreturn $ctrl.$q.when().then(() => $ctrl.petData.loadPets(status, !!force)).then(list => {\n  if (token !== $ctrl.requestToken || status !== $ctrl.status) { return; }\n  if (!Array.isArray(list)) { throw new Error('The pet service returned an invalid list. Please retry.'); }\n  $ctrl.allPets = list.slice();\n  $ctrl.searchIndex = $ctrl.allPets.map(pet => ({ pet: pet, text: [pet.name, pet.category, String(pet.id)].concat(pet.tags).join(' ').toLocaleLowerCase() }));\n  const categories = Array.from(new Set($ctrl.allPets.map(pet => pet.category))).sort((a, b) => a.localeCompare(b, undefined, { sensitivity: 'base' }));\n  $ctrl.categoryOptions = [{ label: 'All categories', value: '*' }].concat(categories.map(name => ({ label: name, value: 'category:' + name })));\n  if (!$ctrl.categoryOptions.some(option => option.value === $ctrl.category)) { $ctrl.category = '*'; }\n  // Only use a timestamp proven to describe this exact public service list.\n  if ($ctrl.petData.currentStatus === status && $ctrl.petData.pets === list) {\n    $ctrl.updatedAt = $ctrl.petData.lastUpdated;\n  }\n  $ctrl.applyFilters();\n}).catch(err => {\n  if (token !== $ctrl.requestToken || status !== $ctrl.status) { return; }\n  $ctrl.loadError = (err && err.message) || 'Unable to load pets. Please try again.';\n  $ctrl.allPets = [];\n  $ctrl.searchIndex = [];\n  $ctrl.applyFilters();\n}).finally(() => {\n  if (token === $ctrl.requestToken && status === $ctrl.status) { $ctrl.isLoading = false; }\n});",
      "description": "Loads real normalized data via the confirmed service, handles rejection, ignores stale selections, and keeps promise updates within Angular's $q digest. Clears page-only snapshots before any request; preserves shared service cache.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "loadPets",
