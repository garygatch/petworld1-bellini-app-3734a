            "text-xs",
            "leading-5",
            "text-slate-500"
          ],
          "layout": {
            "cell": {
              "type": "box-item"
            }
          },
          "name": "footer"
        }
      ],
      "classList": [
        "min-w-0",
        "text-slate-900"
      ],
      "layout": {
        "container": {
          "crossAxisAlignment": "stretch",
          "gap": "24px",
          "mainAxisAlignment": "flex-start",
          "orientation": "column",
          "type": "box"
        }
      },
      "name": "div"
    }
  ],
  "description": "## Countries directory\n- **Routing:** `workspace.countries` at `/app/countries`, inside the persistent workspace shell; no URL parameters.\n- **Service cache:** `countryData` owns Countries GraphQL transport, a ten-minute cache and shared pending requests. Refresh/Retry forces a load; failures retain cached results. Successful loads explicitly call `syncData` for metrics, continent options and filtering.\n- **Filters:** verified core `onValueChange` callbacks assign search (250 ms core debounce), continent and name sort before applying local filters and resetting page one; no filter watcher is required. Shared records are never mutated.\n- **Pagination:** twelve results per page, clamped after refresh, with an accessible result range.\n- **Inline details and focus:** `pw-country-card` emits the named `country` local, passed directly to `selectCountry(country)`. Opening details focuses their heading; closing restores the initiating button or falls back to the results heading. No dialog or route change.",
  "name": "countries",
  "params": {},
  "parentPageName": "workspace",
  "type": "page",
  "url": "/countries",
  "variables": [
    {
      "id": "service",
      "name": "countryData",
      "resourceIdentity": "services/country-data",
      "type": "service"
    },
    {
      "name": "$q",
      "type": "service"
    },
    {
      "name": "$timeout",
      "type": "service"
    },
    {
      "name": "$window",
      "type": "service"
    },
    {
      "description": "Local search across name, native, code, and capital.",
      "name": "searchQuery",
      "type": "property",
      "value": "''"
    },
    {
      "description": "Selected service-derived continent code or all.",
      "name": "continent",
      "type": "property",
      "value": "'all'"
    },
    {
      "description": "Local name ordering, asc or desc.",
      "name": "sortOrder",
      "type": "property",
      "value": "'asc'"
    },
    {
      "description": "Dropdown options built only from countryData.continents.",
      "name": "continentOptions",
      "type": "property",
      "value": "[{label: 'All continents', value: 'all'}]"
    },
    {
      "description": "Full-directory metrics; unknown until a successful service load.",
      "name": "metrics",
      "type": "property",
      "value": "{countries: '—', continents: '—', languages: '—'}"
    },
    {
      "description": "Filtered and sorted copy; never mutates the shared cache.",
      "name": "filteredCountries",
      "type": "property",
      "value": "[]"
    },
    {
      "description": "At most twelve normalized country records for the current page.",
      "name": "pageCountries",
      "type": "property",
      "value": "[]"
    },
    {
      "description": "One-based core pagination state, clamped on every slice.",
      "name": "currentPage",
      "type": "property",
      "value": "1"
    },
    {
      "description": "Ceiling of filtered count divided by twelve, with an internal minimum of one.",
      "name": "totalPages",
      "type": "property",
      "value": "1"
    },
    {
      "description": "Accessible exact range and filtered record count.",
      "name": "resultSummary",
      "type": "property",
      "value": "'No countries loaded yet.'"
    },
    {
      "description": "Page-owned pending request flag; also consult shared service loading.",
      "name": "loading",
      "type": "property",
      "value": "false"
    },
    {
      "description": "Safe load failure message, retaining previously cached results.",
      "name": "loadError",
      "type": "property",
      "value": "null"
    },
    {
      "description": "Currently inspected normalized country; inline only.",
      "name": "selectedCountry",
      "type": "property",
      "value": "null"
    },
    {
      "description": "Plain-text definition-list rows derived from the selected record.",
      "name": "detailFields",
      "type": "property",
      "value": "[]"
    },
    {
      "description": "Initiating DOM control, used only for focus restoration.",
      "name": "returnFocus",
      "type": "property",
      "value": "null"
    },
    {
      "body": "const records = $ctrl.countryData.countries || [];\n$ctrl.continentOptions = [{ label: 'All continents', value: 'all' }].concat(($ctrl.countryData.continents || []).map(c => ({ label: c.name, value: c.code })));\nif ($ctrl.countryData.lastUpdated != null) {\n  const continents = new Set(records.map(c => c.continentCode).filter(Boolean));\n  const languages = new Set(records.flatMap(c => Array.isArray(c.languages) ? c.languages : []).filter(name => typeof name === 'string' && name.trim()).map(name => name.trim()));\n  $ctrl.metrics = { countries: String(records.length), continents: String(continents.size), languages: String(languages.size) };\n} else {\n  $ctrl.metrics = { countries: '—', continents: '—', languages: '—' };\n}\n$ctrl.applyFilters(false);",
      "description": "Recomputes metrics and continent options from the normalized shared cache, then clamps the local page without mutating service arrays.",
      "invokeOnLoad": true,
      "isAsync": false,
      "name": "syncData",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": [
        "$ctrl.countryData.countries",
        "$ctrl.countryData.continents",
        "$ctrl.countryData.lastUpdated"
      ]
    },
    {
      "body": "if ($ctrl.loading) { return; }\n$ctrl.loading = true;\n$ctrl.loadError = null;\n// The service owns network access, shared in-flight work, and caching.\nreturn $ctrl.$q.when().then(() => $ctrl.countryData.loadCountries(force === true)).then(() => {\n  $ctrl.syncData();\n}).catch(() => {\n  $ctrl.loadError = 'Unable to load country data. Please try again. Previously loaded data, if available, is still shown.';\n}).finally(() => {\n  $ctrl.loading = false;\n});",
      "description": "Initial cached load, or forced Refresh/Retry. Uses Angular promise callbacks for digest-safe success, caught failure, and final cleanup; retains cached records on failure.",
      "invokeOnLoad": true,
      "isAsync": false,
      "name": "loadCountries",
      "parameters": [
        "force"
      ],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "const query = String($ctrl.searchQuery || '').trim().toLocaleLowerCase();\nconst records = $ctrl.countryData.countries || [];\n$ctrl.filteredCountries = records.filter(c => ($ctrl.continent === 'all' || c.continentCode === $ctrl.continent) && (!query || [c.name, c.native, c.code, c.capital].some(value => String(value || '').toLocaleLowerCase().includes(query)))).slice().sort((a, b) => {\n  const order = a.name.localeCompare(b.name) || a.code.localeCompare(b.code);\n  return $ctrl.sortOrder === 'desc' ? -order : order;\n});\n$ctrl.totalPages = Math.max(1, Math.ceil($ctrl.filteredCountries.length / 12));\n$ctrl.changePage(resetPage ? 1 : $ctrl.currentPage);",
      "description": "Case-insensitive search and exact continent match, followed by deterministic name sorting. Resets page on user filter/sort actions; clamps on data refresh.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "applyFilters",
      "parameters": [
        "resetPage"
      ],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "$ctrl.searchQuery = newValue;\n$ctrl.applyFilters(true);",
      "description": "Core Text Input callback receives newValue and event after its 250 ms debounce, explicitly stores the search and resets filtered pagination.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "onSearchChanged",
      "parameters": [
        "newValue",
        "event"
      ],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "$ctrl.continent = value;\n$ctrl.applyFilters(true);",
      "description": "Core Dropdown callback explicitly stores its value local as the continent before filtering and resetting page one.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "onContinentChanged",
      "parameters": [
        "value",
        "event"
      ],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "$ctrl.sortOrder = value;\n$ctrl.applyFilters(true);",
      "description": "Core Dropdown callback explicitly stores its value local as the sort order before filtering and resetting page one.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "onSortOrderChanged",
      "parameters": [
        "value",
        "event"
      ],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "$ctrl.currentPage = Math.max(1, Math.min($ctrl.totalPages, Math.floor(Number(currentPage) || 1)));\nconst count = $ctrl.filteredCountries.length;\nconst start = ($ctrl.currentPage - 1) * 12;\n$ctrl.pageCountries = $ctrl.filteredCountries.slice(start, start + 12);\n$ctrl.resultSummary = count ? 'Showing ' + (start + 1) + '–' + Math.min(start + 12, count) + ' of ' + count + ' countries' : '0 countries match your filters';",
      "description": "Clamps page number, slices twelve results, and calculates an accurate zero-safe range.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "changePage",
      "parameters": [
        "currentPage"
      ],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "$ctrl.searchQuery = '';\n$ctrl.continent = 'all';\n$ctrl.sortOrder = 'asc';\n$ctrl.applyFilters(true);",
      "description": "Restores all continents, an empty search, A–Z sorting and page one. Used by both filter-bar and empty-state Reset actions.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "resetFilters",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "if (!country) { return; }\n$ctrl.returnFocus = $ctrl.$window.document.activeElement;\n$ctrl.selectedCountry = country;\nconst phone = country.phone ? String(country.phone).split(',').map(code => '+' + code.trim().replace(/^\\+/, '')).join(', ') : '—';\n$ctrl.detailFields = [\n  { label: 'Name', value: country.name || '—' },\n  { label: 'Native name', value: country.native || '—' },\n  { label: 'Capital', value: country.capital || '—' },\n  { label: 'Currency', value: country.currency || '—' },\n  { label: 'Calling code', value: phone },\n  { label: 'Languages', value: country.languages && country.languages.length ? country.languages.join(', ') : '—' },\n  { label: 'Continent', value: country.continentName || '—' },\n  { label: 'ISO code', value: country.code || '—' }\n];\n$ctrl.$timeout(() => {\n  const heading = $ctrl.$window.document.getElementById('pw-country-detail-heading');\n  if (heading) { heading.focus(); }\n}, 0);",
      "description": "Receives the card callback's named country local, builds all detail rows and focuses the inline heading after it mounts.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "selectCountry",
      "parameters": [
        "country"
      ],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "$ctrl.selectedCountry = null;\n$ctrl.$timeout(() => {\n  const document = $ctrl.$window.document;\n  const target = $ctrl.returnFocus && document.contains($ctrl.returnFocus) ? $ctrl.returnFocus : document.getElementById('pw-countries-results');\n  if (target) { target.focus(); }\n  $ctrl.returnFocus = null;\n}, 0);",
      "description": "Closes the inline region and restores the initiating button focus, falling back to the results heading when the card is no longer mounted.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "closeDetails",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    }
  ]
}
