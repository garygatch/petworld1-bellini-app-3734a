  "name": "pet-detail",
  "params": {
    "id": ""
  },
  "parentPageName": "workspace",
  "type": "page",
  "url": "/pets/:id",
  "variables": [
    {
      "id": "service",
      "name": "petData",
      "resourceIdentity": "services/pet-data",
      "type": "service"
    },
    {
      "name": "$state",
      "type": "service"
    },
    {
      "name": "$q",
      "type": "service"
    },
    {
      "description": "Local request flag; only the current request token may clear it.",
      "name": "loading",
      "type": "property",
      "value": "true"
    },
    {
      "description": "Safe service error message for non-404 failures, rendered as plain text.",
      "name": "error",
      "type": "property",
      "value": "null"
    },
    {
      "description": "True for invalid/missing IDs, absent records, or confirmed 404 responses.",
      "name": "notFound",
      "type": "property",
      "value": "false"
    },
    {
      "description": "Read-only normalized detail; only id, name, category, status and tags are consumed.",
      "name": "pet",
      "type": "property",
      "value": "null"
    },
    {
      "description": "Monotonic request token preventing stale result and finalizer writes.",
      "name": "sequence",
      "type": "property",
      "value": "0"
    },
    {
      "description": "Last observed string ID; suppresses duplicate initial watch loads.",
      "name": "lastRouteId",
      "type": "property",
      "value": "null"
    },
    {
      "description": "Only valid integer-string route IDs can be retried or refreshed.",
      "name": "canRetry",
      "type": "property",
      "value": "false"
    },
    {
      "description": "Distinct guidance for invalid links versus confirmed missing demo records.",
      "name": "notFoundMessage",
      "type": "property",
      "value": "''"
    },
    {
      "description": "Semantic styling of reported API status; not an availability guarantee.",
      "name": "statusColor",
      "type": "property",
      "value": "'default'"
    },
    {
      "body": "const params = $ctrl.$state.params || {};\nconst raw = params.id !== undefined && params.id !== null ? params.id : ($ctrl.pageParameters && $ctrl.pageParameters.id);\nreturn raw === undefined || raw === null ? '' : String(raw);",
      "description": "Reads the live UI-Router ID without numeric conversion. Bellini pageParameters provides the initial fallback.",
      "invokeOnLoad": false,
      "isAsync": false,
      "name": "routeId",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": []
    },
    {
      "body": "const id = $ctrl.routeId();\nif ($ctrl.lastRouteId === id) { return; }\n$ctrl.lastRouteId = id;\nreturn $ctrl.loadPet(false);",
      "description": "Loads direct links and changed route parameters, avoiding duplicate init/watch work.",
      "invokeOnLoad": true,
      "isAsync": false,
      "name": "syncRoute",
      "parameters": [],
      "returnType": {
        "name": "any"
      },
      "type": "method",
      "watch": [
        "$ctrl.$state.params.id",
        "$ctrl.pageParameters.id"
      ]
